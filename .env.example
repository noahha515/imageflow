# ---- API (apps/api) ----
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API (the web playground in dev).
CORS_ORIGINS=http://localhost:5173
# Set to true only when running behind a trusted reverse proxy / load balancer,
# otherwise clients can spoof X-Forwarded-For and evade rate limiting.
TRUST_PROXY=false
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500
CACHE_MAX_BYTES=104857600
MAX_CONCURRENT_JOBS=8

# ---- Web (apps/web) — read by Vite at build/dev time ----
VITE_API_BASE_URL=http://localhost:3000
